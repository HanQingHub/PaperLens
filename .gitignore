# 构建产物
dist/
apps/desktop/dist/
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/server-dist/
apps/desktop/src-tauri/ocr-dist/
apps/desktop/src-tauri/resources/
apps/desktop/node_modules/
node_modules/

# binaries 下除占位目录外均为打包产物
apps/desktop/src-tauri/binaries/*
!apps/desktop/src-tauri/binaries/paperlens-server/
apps/desktop/src-tauri/binaries/paperlens-server/_internal/
apps/desktop/src-tauri/binaries/paperlens-server/paperlens-server.exe
!apps/desktop/src-tauri/binaries/paperlens-server/PLACEHOLDER.md

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# 开发数据（含账号数据，禁止入库）
.dev-data/

# 大资产（有独立下载源/生成脚本，不入库）
# bundle-resources 由 assets 经脚本生成（0.8B 拷贝 + ecdict_import.py），同样不入库
apps/desktop/src-tauri/bundle-resources/
assets/models/
assets/wheels/
assets/ecdict/stardict.db
assets/ecdict/ecdict-sqlite-28.zip
assets/ecdict/ecdict.db

# 工具会话状态
.freebuff/

# 更新签名私钥（公钥内嵌 tauri.conf.json；私钥仅本机保留，丢失将无法再发布更新）
scripts/keys/*.key

# 日志/临时
*.log
*.tsbuildinfo
.tmp-*
vite-dev*
.workbuddy/

# 本地工具会话状态（不入库）
.trae/
# opencode 会话状态与日志（不入库）
.opencode/
# 本地工作文档（仅本地，不入库）
docs/AGENT-REPORT-*.md
docs/DECISION-*.md
docs/DISCOVERY-*.md

# 文档
docs/
