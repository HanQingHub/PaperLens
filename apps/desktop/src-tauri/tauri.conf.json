{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PaperLens",
  "version": "0.1.0",
  "identifier": "com.paperlens.app",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PaperLens",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/paperlens-server"],
    "resources": {
      "bundle-resources/models/Qwen3.5-0.8B-Q4_K_M.gguf": "resources/models/Qwen3.5-0.8B-Q4_K_M.gguf",
      "bundle-resources/ecdict.db": "resources/ecdict.db",
      "ocr-dist/paperlens-ocr": "resources/paperlens-ocr"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "template": "installer.nsi",
        "installMode": "currentUser"
      }
    }
  }
}
