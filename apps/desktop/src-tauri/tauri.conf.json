{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PaperLens",
  "version": "0.6.6",
  "identifier": "com.paperlens.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PaperLens",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": true,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src ipc: http://ipc.localhost http://tauri.localhost http://127.0.0.1:8737 http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": {
      "binaries/paperlens-server": "resources/paperlens-server",
      "bundle-resources/models/Qwen3.5-0.8B-Q4_K_M.gguf": "resources/models/Qwen3.5-0.8B-Q4_K_M.gguf",
      "bundle-resources/ecdict.db": "resources/ecdict.db",
      "ocr-dist/paperlens-ocr": "resources/paperlens-ocr"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "template": "installer.nsi",
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg2OTlDODE1OEQ3MEE3OEUKUldTT3AzQ05GY2laaHRwdlJBT0wxZVQ5bnM0MWJDN1k2WEVlU2IzYlRMOFBuVFByYWNqR1U4a1IK",
"endpoints": [
        "https://github.com/HanQingHub/PaperLens/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}







